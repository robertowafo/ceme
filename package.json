{
  "name": "ceme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev": "wrangler pages dev --proxy 5173",
    "build": "vite build",
    "deploy": "vite build && wrangler pages deploy dist --project-name=ceme",
    "db:local": "wrangler d1 execute ceme-db --local --file=db/schema.sql",
    "db:remote": "wrangler d1 execute ceme-db --file=db/schema.sql",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@react-oauth/google": "^0.12.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "gsap": "^3.15.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "lenis": "^1.3.24",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
