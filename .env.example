# ── Variables Cloudflare Pages ────────────────────────────────────────────────
# Ces variables sont configurées dans le dashboard Cloudflare Pages
# Settings → Environment variables  (pour les vars publiques)
# Settings → Secrets               (pour les données sensibles)
#
# En local (dev), créer un fichier .dev.vars à la racine du projet :

# ── Frontend (Vite) — préfixe VITE_ obligatoire ───────────────────────────────
VITE_GOOGLE_CLIENT_ID="VOTRE_GOOGLE_CLIENT_ID"

# ── Secrets backend (dans .dev.vars pour le dev local) ────────────────────────
JWT_SECRET="chaine-secrete-aleatoire-minimum-32-caracteres"
ADMIN_EMAIL="admin@votredomaine.com"
YOUTUBE_API_KEY="VOTRE_CLE_YOUTUBE"

# ── Cloudflare R2 (configurer dans wrangler.toml) ─────────────────────────────
BUCKET_URL="https://pub-XXXX.r2.dev"

# ── D1 (configurer dans wrangler.toml) ───────────────────────────────────────
# database_id = obtenu après : wrangler d1 create ceme-db
