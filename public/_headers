# En-têtes de sécurité de base sur tout le site.
# Pas de CSP ici : le site charge des iframes YouTube, Google Fonts, l'OAuth
# Google et des images R2 cross-origin — une CSP mal calibrée casserait ces
# fonctionnalités sans un audit dédié page par page.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Assets Vite (noms de fichiers hashés — invalidés automatiquement à chaque build)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Polices auto-hébergées (changent rarement)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photos et médias uploadés (peuvent être remplacés par l'admin — cache modéré)
/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Favicons / logos
/favicon*
  Cache-Control: public, max-age=604800
/logo-*.png
  Cache-Control: public, max-age=604800
